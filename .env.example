# Copiar a .env y completar con los datos de tu Postgres local.
# El .env real esta en .gitignore: no se commitea.

DB_USER=klein
DB_PASSWORD=klein_local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transporte_klein_db

PORT=3000

# Secreto con el que se firman y verifican los tokens de sesion.
# El servidor NO arranca si falta: sin esto, cualquiera que conozca el valor
# por defecto podria fabricarse un token de administrador.
# Genera el tuyo con:  openssl rand -base64 32
JWT_SECRET=cambiar_en_cada_entorno
